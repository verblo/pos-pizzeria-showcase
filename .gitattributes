# Auto detect text files and perform LF normalization
* text=auto

# Source files
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wav binary
*.woff binary
*.woff2 binary

# Database files (binary)
*.sqlite binary
*.sqlite-journal binary
*.sqlite-shm binary
*.sqlite-wal binary

